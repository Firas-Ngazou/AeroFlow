}
QSpinBox[class="settings_spin_box"]::up-button:hover{
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
}
QSpinBox[class="settings_spin_box"]::down-button:hover{
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
}



QComboBox[class="settings_combo_box"]{
    border: 2px solid #1D1D1D;
    padding: 1px 18px 1px 20px;
    background-color: #F5F5F5;
    border-radius: 15;
    color: #1D1D1D;
}
QComboBox[class="settings_combo_box"]::drop-down{
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
}
QComboBox[class="settings_combo_box"]::down-arrow{
    image: url(:/res/double_arrows_black.png);
    width: 20px;
    height: 20px;
}
QAbstractItemView{
    background-color: #F5F5F5;
    color: #1D1D1D;
    border: 1px solid #1D1D1D;
    selection-background-color: #1D1D1D;
    selection-color: #F5F5F5;
    outline: 0px;
}