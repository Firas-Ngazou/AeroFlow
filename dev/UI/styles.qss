QPushButton[class="reset_pb"]{
    background-color: #8EE7FF;
    color: #1D1D1D;
    padding-left: 15px;
    padding-right: 15px;
    border-radius: 12px;
}
QPushButton[class="reset_pb"]:hover{
    background-color: #99DEFFFF;
}
QPushButton[class="reset_pb"]:pressed{
    background-color: #AEE7FFFF;
}



QPushButton[class="settings_tab_pb"]{
    background-color: #F5F5F5;
    color: #1D1D1D;
    padding-left: 15px;
    padding-right: 15px;
    border-radius: 15px;
}
QPushButton[class="settings_tab_pb"]:hover{
    background-color: #e0e0e0;
}
QPushButton[class="settings_tab_pb"]:pressed{
    background-color: #c0c0c0;
}
QPushButton[class="settings_tab_pb"]:checked{
    background-color: #A6A6A6;
}



QPushButton[class="tool_pb"]{
    background-color: #F5F5F5;
    color: #1D1D1D;
    padding-left: 15px;
    padding-right: 15px;
    border-radius: 22px;
}
QPushButton[class="tool_pb"]:hover{
    background-color: #e0e0e0;
}
QPushButton[class="tool_pb"]:pressed{
    background-color: #c0c0c0;
}
QPushButton[class="tool_pb"]:checked{
    background-color: #A6A6A6;
}



QPushButton[class="play_pb"]{
    background-color: #92B28A;
    color: #1D1D1D;
    padding-left: 15px;
    padding-right: 15px;
    border-radius: 22px;
}
QPushButton[class="play_pb"]:hover{
    background-color: #a1c9ac;
}
QPushButton[class="play_pb"]:pressed{
    background-color: #c0c0c0;
}
QPushButton[class="play_pb"]:checked{
    background-color: #BA7475;
}



QPushButton[class="pause_pb"]{
    background-color: #FFCACB;
    color: #1D1D1D;
    padding-left: 15px;
    padding-right: 15px;
    border-radius: 22px;
}
QPushButton[class="pause_pb"]:hover{
    background-color: #BA7475;
}
QPushButton[class="pause_pb"]:pressed{
    background-color: #BA7475;
}
QPushButton[class="pause_pb"]:checked{
    background-color: #92B28A;
}



QFrame[class="primary_frame"]{
    background-color: #222;
    border: 1px solid #F5F5F5;
    border-radius: 26px;
}

QFrame[class="constraint_frame"]{
    background-color: #222;
    border: 1px solid #F5F5F5;
    border-radius: 15px;
}



QSlider[class="settings_slider"]::groove:horizontal{
    border: 1px solid #F5F5F5;
    height: 4px;
    background-color: #1D1D1D;
    margin: 2px 0;
    border-radius: 5px;
}
QSlider[class="settings_slider"]::handle:horizontal{
    background-color: #F5F5F5;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
}
QSlider[class="settings_slider"]::sub-page:horizontal{
    background-color: #F5F5F5;
    border-color: transparent;
    height: 4px;
    border-radius: 5px;
}
QSlider[class="settings_slider"]::add-page:horizontal{
    background-color: #1D1D1D;
    border: 1px solid #F5F5F5;
    height: 4px;
    border-radius: 5px;
}



QDoubleSpinBox[class="settings_spin_box"]{
    background-color: #F5F5F5;
    color: #1D1D1D;
    border-radius: 12px;
    padding-left: 7px;
    padding-right: 40px;
}
QDoubleSpinBox[class="settings_spin_box"]::up-button{
    background-color: transparent;
    border: none;
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 20px;
    height: 20px;
}
QDoubleSpinBox[class="settings_spin_box"]::down-button{
    background-color: transparent;
    border: none;
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 20px;
    height: 20px;
}
QDoubleSpinBox[class="settings_spin_box"]::up-button{
    right: 20px;
}
QDoubleSpinBox[class="settings_spin_box"]::down-button{
    right: 2px;
}
QDoubleSpinBox[class="settings_spin_box"]::up-arrow{
    image: url(:/res/up_arrow_black.png);
    width: 16px;
    height: 16px;
}
QDoubleSpinBox[class="settings_spin_box"]::down-arrow{
    image: url(:/res/down_arrow_black.png);
    width: 16px;
    height: 16px;
}
QDoubleSpinBox[class="settings_spin_box"]::up-button:hover{
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
}
QDoubleSpinBox[class="settings_spin_box"]::down-button:hover{
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
}



QSpinBox[class="settings_spin_box"]{
    background-color: #F5F5F5;
    color: #1D1D1D;
    border-radius: 12px;
    padding-left: 7px;
    padding-right: 40px;
}
QSpinBox[class="settings_spin_box"]::up-button{
    background-color: transparent;
    border: none;
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 20px;
    height: 20px;
}
QSpinBox[class="settings_spin_box"]::down-button{
    background-color: transparent;
    border: none;
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 20px;
    height: 20px;
}
QSpinBox[class="settings_spin_box"]::up-button{
    right: 20px;
}
QSpinBox[class="settings_spin_box"]::down-button{
    right: 2px;
}
QSpinBox[class="settings_spin_box"]::up-arrow{
    image: url(:/res/up_arrow_black.png);
